Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1.0
      Color: 160; 160; 160
      Plane: XY
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic: /robot_description
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.2
    - Class: rviz_default_plugins/Path
      Name: MotionPath
      Enabled: true
      Topic: /robot_path
      Color: 255; 0; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Odometry
      Name: LocationOdometry
      Enabled: true
      Topic: /odom
      Shape: Arrow
      Color: 0; 255; 0
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Pitch: 0.4
      Yaw: 0.8
      Target Frame: base_link
      Value: Orbit (rviz)
